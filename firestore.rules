rules_version = '2';

// Firestore rules for the /prep hub (Firebase project "interviewstepper").
// Paste into Firebase console → Firestore → Rules → Publish.
// Each signed-in user can read and write only their own document, users/<uid>,
// holding just their daily streak and drag-to-sort score. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['daily', 'sort', 'updatedAt'])
        && (!('daily' in request.resource.data) || request.resource.data.daily is map)
        && (!('sort' in request.resource.data) || request.resource.data.sort is map);
    }
  }
}
